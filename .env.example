# Google AI Studio key used only to create Gemini embeddings.
GOOGLE_API_KEY=replace_with_your_google_api_key

# Recommended for the instructor's "qdrant, free collection create" note.
QDRANT_MODE=cloud
QDRANT_URL=https://your-cluster-id.region.cloud.qdrant.io
QDRANT_API_KEY=replace_with_your_qdrant_api_key

# Local fallback: set QDRANT_MODE=local. No Qdrant credentials are then needed.
QDRANT_LOCAL_PATH=data/qdrant_storage
QDRANT_COLLECTION=college_prospectus

# Optional model and chunking overrides.
EMBEDDING_MODEL=models/gemini-embedding-001
CHAT_MODEL=gemini-3.6-flash
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
